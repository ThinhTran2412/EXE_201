{
  "expo": {
    "name": "ShootMatch",
    "slug": "shootmatch-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff7e1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shootmatch.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cho phép ShootMatch truy cập vị trí của bạn để theo dõi tiến trình di chuyển của buổi chụp ảnh.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Cho phép ShootMatch truy cập vị trí của bạn để theo dõi tiến trình di chuyển của buổi chụp ảnh."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff7e1"
      },
      "package": "com.shootmatch.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
