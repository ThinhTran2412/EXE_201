{
  "expo": {
    "name": "Pickic",
    "slug": "shootmatch-mobile",
    "scheme": "shootmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.shootmatch.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cho phép ShootMatch truy cập vị trí của bạn để theo dõi tiến trình di chuyển của buổi chụp ảnh.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Cho phép ShootMatch truy cập vị trí của bạn để theo dõi tiến trình di chuyển của buổi chụp ảnh."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.shootmatch.mobile",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "shortName": "Pickic",
      "themeColor": "#fff7e1",
      "backgroundColor": "#fff7e1",
      "display": "standalone",
      "startUrl": "."
    },
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
